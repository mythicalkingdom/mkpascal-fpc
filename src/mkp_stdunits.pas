    + '    end;' + #10
    + '  end;' + #10
    + 'end;' + #10
    + '' + #10
    + 'procedure TCollection.AtPut(Index: Integer; Item: Pointer);' + #10
    + 'begin' + #10
    + '  if (Index < 0) or (Index >= Count) then Error(coIndexError, Index)' + #10
    + '  else Items^[Index] := Item;' + #10
    + 'end;' + #10
    + '' + #10
    + 'procedure TCollection.Delete(Item: Pointer);' + #10
